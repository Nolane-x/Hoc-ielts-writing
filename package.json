{
  "name": "wmr-writing-mentor",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "Local-first IELTS Writing mentor with evidence-grounded assessment and optional multi-provider AI.",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node server/index.mjs",
    "test": "node --test",
    "check": "node --check server/index.mjs && node --check web/app.mjs && node --check web/writing-agent.mjs && node --check web/agent-practice.mjs && node --check web/academy-studio.mjs && node --check scripts/evaluate-benchmark.mjs && node --test",
    "build:web": "vite build",
    "dist:desktop": "npm run build:web && electron-builder",
    "mobile:sync": "npm run build:web && cap sync android",
    "evaluate:benchmark": "node scripts/evaluate-benchmark.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "org.nolane.wmrwritingmentor",
    "productName": "WMR Writing Mentor",
    "asar": true,
    "files": [
      "dist/**/*",
      "server/**/*",
      "web/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "Nolane-x"
    }
  }
}
